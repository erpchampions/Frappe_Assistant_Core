#!/usr/bin/env bash
# FAC Bridge launcher — just run: fac <url> or fac <sitename>
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
cd "$SCRIPT_DIR"

if [ $# -eq 0 ]; then
    python bridge.py serve
elif [[ "$1" == http* ]]; then
    python bridge.py serve -u "$1"
else
    python bridge.py serve "$@"
fi
